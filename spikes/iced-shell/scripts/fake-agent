#!/bin/sh
# A stand-in for the Claude Code and Codex CLIs, for testing the chat pane
# without an account. It reads the prompt on standard input and writes the
# same JSON lines the real CLI writes. Point the app at it:
#
#   KRANG_CLAUDE_BIN=scripts/fake-agent KRANG_CODEX_BIN=scripts/fake-agent
#
# What the prompt contains picks the case:
#   "error"   the run fails with an error result and exit code 1
#   "crash"   no result at all, a message on stderr and exit code 2
#   "slow"    the reply streams for about ten seconds (try Stop)
#   anything else: a short Markdown reply with a code block and a tool call

prompt=$(cat | tr '\n' ' ' | sed 's/\\/\\\\/g; s/"/\\"/g')
session="fake-$$"
codex=false
previous=""
while [ $# -gt 0 ]; do
  case "$1" in
    --resume) previous="$2"; shift ;;
    exec) codex=true ;;
    resume) codex=true; previous="$2"; shift ;;
  esac
  shift
done
[ -n "$previous" ] && session="$previous"

delta() {
  printf '{"type":"stream_event","event":{"type":"content_block_delta","delta":{"type":"text_delta","text":"%s"}}}\n' "$1"
}

if $codex; then
  printf '{"type":"thread.started","thread_id":"%s"}\n' "$session"
  printf '{"type":"item.started","item":{"id":"i1","type":"command_execution","command":"ls -la"}}\n'
  case "$prompt" in
    *error*) printf '{"type":"turn.failed","error":{"message":"The fake agent was asked to fail"}}\n'; exit 1 ;;
  esac
  printf '{"type":"item.completed","item":{"id":"i2","type":"agent_message","text":"Codex heard: %s"}}\n' "$prompt"
  printf '{"type":"turn.completed","usage":{"input_tokens":120,"cached_input_tokens":30,"output_tokens":42}}\n'
  exit 0
fi

printf '{"type":"system","subtype":"init","session_id":"%s"}\n' "$session"
case "$prompt" in
  *crash*)
    echo "fatal: the fake agent crashed on purpose" >&2
    exit 2 ;;
  *error*)
    delta "Trying..."
    printf '{"type":"result","subtype":"error_during_execution","is_error":true,"session_id":"%s","errors":["The fake agent was asked to fail"]}\n' "$session"
    exit 1 ;;
  *slow*)
    i=0
    while [ $i -lt 40 ]; do
      delta "word$i "
      i=$((i + 1))
      sleep 0.25
    done ;;
esac
printf '{"type":"stream_event","event":{"type":"content_block_start","content_block":{"type":"tool_use","id":"tool-1","name":"Read"}}}\n'
printf '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"tool-1","name":"Read","input":{"file_path":"README.md"}}]}}\n'
delta "You said: **$prompt**"
delta "\\n\\nSession \`$session\`. Here is code:\\n\\n"
delta "\`\`\`rust\\nfn main() {\\n    println!(\\\"hello\\\");\\n}\\n\`\`\`\\n"
printf '{"type":"assistant","message":{"content":[{"type":"text","text":"You said: **%s**\\n\\nSession `%s`. Here is code:\\n\\n```rust\\nfn main() {\\n    println!(\\"hello\\");\\n}\\n```\\n"}]}}\n' "$prompt" "$session"
printf '{"type":"result","subtype":"success","session_id":"%s","total_cost_usd":0.0123,"usage":{"input_tokens":12,"cache_read_input_tokens":300,"output_tokens":45}}\n' "$session"
