{
  "name": "krang-desktop",
  "version": "0.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint //#lint:root",
    "lint:root": "eslint 'packages/*-config/**' '*.js' --max-warnings 0",
    "typecheck": "turbo run typecheck //#typecheck:root",
    "typecheck:root": "tsc --noEmit",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "build": "turbo run build",
    "check": "turbo run //#format:check lint //#lint:root typecheck //#typecheck:root test"
  },
  "devDependencies": {
    "@krang-desktop/eslint-config": "workspace:*",
    "@krang-desktop/prettier-config": "workspace:*",
    "@krang-desktop/tsconfig-config": "workspace:*",
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
